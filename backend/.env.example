# Application Settings
APP_NAME=Gmail AI Organizer
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=your-secret-key-change-this-in-production

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./gmail_organizer.db
# For PostgreSQL: postgresql://user:password@localhost/gmail_organizer

# Google OAuth 2.0 Configuration
# Get these from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# Google API Scopes (comma-separated)
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.modify,https://www.googleapis.com/auth/calendar

# AI Configuration - BYOK (Bring Your Own Keys)
# Users can add their own keys for unlimited usage
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Project AI Keys (Free Tier - Limited Quota)
# These are provided by the project for free tier users
PROJECT_ANTHROPIC_KEY=
PROJECT_OPENAI_KEY=
FREE_TIER_MONTHLY_LIMIT=100

# AI Model Configuration
DEFAULT_AI_PROVIDER=anthropic  # Options: anthropic, openai, local
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OPENAI_MODEL=gpt-4-turbo-preview

# Local AI Support (Ollama, LM Studio)
LOCAL_AI_ENABLED=False
LOCAL_AI_ENDPOINT=http://localhost:11434
LOCAL_AI_MODEL=llama2

# Email Processing
MAX_EMAILS_PER_REQUEST=50
EMAIL_BATCH_SIZE=10
AUTO_CATEGORIZE=True

# Calendar Settings
CALENDAR_LOOKAHEAD_DAYS=30
AUTO_CREATE_EVENTS=False

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# CORS Settings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=True

# Session
SESSION_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Feature Flags
ENABLE_ANALYTICS=True
ENABLE_EMAIL_SUMMARIZATION=True
ENABLE_AUTO_TAGGING=True
ENABLE_SMART_REPLIES=False
