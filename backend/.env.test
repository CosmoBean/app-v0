# Test Environment - Mock values for running tests locally
# Copy this to .env when running tests

APP_NAME=Gmail AI Organizer
ENVIRONMENT=test
DEBUG=False
SECRET_KEY=test-secret-key-for-testing-only-not-secure

# Server
HOST=0.0.0.0
PORT=8000

# Database (in-memory for tests)
DATABASE_URL=sqlite+aiosqlite:///:memory:

# Google OAuth (mock values - not real)
GOOGLE_CLIENT_ID=mock_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=mock_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.modify,https://www.googleapis.com/auth/calendar

# AI Configuration (mock values - not real)
ANTHROPIC_API_KEY=mock_anthropic_key
OPENAI_API_KEY=mock_openai_key
PROJECT_ANTHROPIC_KEY=mock_project_anthropic_key
PROJECT_OPENAI_KEY=mock_project_openai_key
FREE_TIER_MONTHLY_LIMIT=100

# AI Model Configuration
DEFAULT_AI_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OPENAI_MODEL=gpt-4-turbo-preview

# Local AI
LOCAL_AI_ENABLED=False
LOCAL_AI_ENDPOINT=http://localhost:11434
LOCAL_AI_MODEL=llama2

# Email Processing
MAX_EMAILS_PER_REQUEST=50
EMAIL_BATCH_SIZE=10
AUTO_CATEGORIZE=True

# Calendar Settings
CALENDAR_LOOKAHEAD_DAYS=30
AUTO_CREATE_EVENTS=False

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# CORS Settings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=True

# Session
SESSION_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Feature Flags
ENABLE_ANALYTICS=True
ENABLE_EMAIL_SUMMARIZATION=True
ENABLE_AUTO_TAGGING=True
ENABLE_SMART_REPLIES=False
